@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@300;400;500;600&family=Inter:wght@300;400;500;600&family=Lora:wght@300;400&display=swap');
:root{--navy:#0D121E;--dorado:#C8B090;--texto:#2C3E50;--fondo:#F8F9FB;--blanco:#fff}
*{margin:0;padding:0;box-sizing:border-box;scroll-behavior:smooth}
body{font-family:'Inter',sans-serif;color:var(--texto);background:var(--blanco);line-height:1.8;-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:'Playfair Display',serif;color:var(--navy)}
header{position:fixed;top:0;left:0;width:100%;z-index:1000;padding:0 24px;height:88px;display:flex;justify-content:space-between;align-items:center;background:rgba(13,18,30,0.96);backdrop-filter:blur(12px);border-bottom:1px solid rgba(200,176,144,0.12);transition:all .4s cubic-bezier(0.2,0.8,0.2,1);overflow:visible!important}
header.shrink{height:72px;background:rgba(13,18,30,0.99);box-shadow:0 4px 20px rgba(0,0,0,.3)}
.marca-estudio{display:flex;align-items:center;gap:16px;text-decoration:none;flex:0 0 auto}
.marca-estudio img{height:48px;width:auto;transition:height .3s}
header.shrink .marca-estudio img{height:36px}
.nombre-estudio{display:flex;flex-direction:column;gap:2px;line-height:1}
.apellido-principal{color:#fff;font-size:15px;letter-spacing:.16em;display:block;font-weight:500;text-transform:uppercase;font-family:'Playfair Display',serif;line-height:1.1}
.apellido-secundario{color:var(--dorado);font-size:15px;letter-spacing:.12em;display:block;text-transform:uppercase;font-family:'Playfair Display',serif;font-weight:300;line-height:1.1;opacity:.95}
nav{flex:1;display:flex;justify-content:center;overflow:visible!important}
nav ul{display:flex;list-style:none;gap:32px;align-items:center;margin:0;overflow:visible!important}
nav a{color:#E8E8E8;font-size:12px;letter-spacing:2.2px;text-transform:uppercase;font-weight:500;text-decoration:none;position:relative}
nav a:hover{color:var(--dorado)}
.right-group{display:flex!important;align-items:center!important;gap:14px!important;flex:0 0 auto}
.btn-area-flex,.btn-nav{border:1px solid var(--dorado);padding:0 22px;height:36px;display:inline-flex;align-items:center;background:transparent;color:#E8DCC8;font-size:12px;letter-spacing:2.2px;text-decoration:none;border-radius:2px;transition:all .3s ease}
.btn-nav:hover{background:var(--dorado);color:#0D121E;box-shadow:0 0 20px rgba(200,176,144,0.6)}

/* MEGA MENU */
.nav-item-mega{position:static!important}
.nav-item-mega>a::after{content:' ▾';font-size:10px;margin-left:4px;opacity:.7}
.mega-panel{position:absolute;left:0;right:0;top:100%;background:#f7f5f0;padding:32px 4% 36px;display:none;grid-template-columns:165px 1fr;gap:34px;z-index:9999;border-top:1px solid rgba(0,0,0,.07);box-shadow:0 22px 40px rgba(0,0,0,.12)}
.nav-item-mega:hover .mega-panel{display:grid}
.mega-left b{font-family:'Inter',sans-serif;font-size:16px;font-weight:800;color:#111;border-bottom:2px solid #111;padding-bottom:5px;display:inline-block}
.mega-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:26px 28px}
.mega-col h4{font-family:'Inter',sans-serif;font-size:11.5px;font-weight:800;line-height:1.3;color:#111;margin:0 0 9px;display:flex;gap:7px;text-transform:uppercase}
.mega-col h4::before{content:'';width:7px;height:7px;background:#111;margin-top:4px;flex-shrink:0;display:block}
.mega-col ul{list-style:none;padding:0 0 0 14px;margin:0}
.mega-col ul li{font-family:'Inter',sans-serif;font-size:11.5px;color:#555;line-height:1.45;margin-bottom:5px;position:relative}
.mega-col ul li::before{content:'• ';margin-left:-8px}

/* HERO */
.hero-principal{min-height:100vh;display:flex;align-items:center;padding:0 12%;position:relative;overflow:hidden;background:var(--navy)}
.hero-video{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;z-index:1}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(13,18,30,0.96) 0%,rgba(13,18,30,0.78) 45%,rgba(13,18,30,0.35) 100%);z-index:2}
.hero-principal::after{content:"";position:absolute;bottom:-1px;left:0;width:100%;height:180px;background:var(--blanco);clip-path:polygon(0 45%,100% 100%,100% 100%,0 100%);z-index:4}
.hero-principal::before{content:"";position:absolute;bottom:178px;left:0;width:100%;height:2.5px;background:#C8B090;transform:skewY(3.8deg);transform-origin:left;z-index:10;box-shadow:0 0 12px rgba(200,176,144,0.5)}
.hero-contenedor-texto{position:relative;z-index:3;max-width:680px;margin-top:-40px;transform:translateY(-2vh)}
.hero-contenedor-texto h1{font-size:54px;line-height:1.12;color:var(--blanco);font-weight:400;margin-bottom:36px;max-width:520px}
.btn-premium-final{display:inline-block;border:1.5px solid var(--dorado);color:#fff;padding:22px 48px;font-size:12px;letter-spacing:3.2px;text-transform:uppercase;font-family:'Playfair Display',serif;font-weight:500;transition:all .3s;text-decoration:none;background:rgba(200,176,144,0.08)}
.btn-premium-final:hover{background:var(--dorado);color:var(--navy);transform:translateY(-2px)}

/* SELLO + BARRA */
.barra-flotante-contacto{position:fixed;right:12px;top:42%;transform:translateY(-50%);z-index:9999;display:flex;flex-direction:column;gap:1px;border-radius:8px;overflow:hidden}
.item-flotante{display:flex;align-items:center;justify-content:flex-end;background:var(--navy);color:#fff;height:52px;min-width:52px;border-left:2px solid var(--dorado);padding:0 16px;text-decoration:none;transition:all .35s}
.item-flotante span{font-size:10px;letter-spacing:2px;max-width:0;opacity:0;overflow:hidden;white-space:nowrap;transition:all .35s}
.item-flotante:hover span{max-width:120px;opacity:1;padding-right:12px}
.investment-seal-link{position:absolute;right:2.5%;bottom:16%;z-index:15;text-decoration:none}
.investment-seal{width:148px;height:148px;position:relative;display:flex;align-items:center;justify-content:center;transition:all .4s ease}
.seal-content{width:108px;height:108px;background:#0F172B;border:1px solid #C8B090;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;box-shadow:0 8px 25px rgba(0,0,0,.45),0 0 18px rgba(200,176,144,0.25);z-index:3}
.seal-year{font-family:'Playfair Display',serif;font-size:9px;letter-spacing:2px;color:#C8B090}
.seal-new{font-family:'Playfair Display',serif;font-size:26px;font-weight:600;color:#C8B090;line-height:1;margin:2px 0}
.seal-text{font-family:'Inter',sans-serif;font-size:8.5px;line-height:1.15;color:#E8DCC8}
.seal-ring,.seal-ring-2,.seal-ring-3{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);border:1px solid #C8B090;border-radius:50%}
.seal-ring{width:126px;height:126px;opacity:.85}.seal-ring-2{width:138px;height:138px;opacity:.45}.seal-ring-3{width:148px;height:148px;opacity:.28;box-shadow:0 0 20px rgba(200,176,144,0.45)}

/* SECCIONES */
section{padding:110px 12%}.encabezado-seccion{text-align:center;max-width:780px;margin:0 auto 80px}.encabezado-seccion h2{font-size:40px;margin-bottom:14px}.linea-decorativa{width:60px;height:2px;background:var(--dorado);margin:0 auto 20px}
.texto-estudio p{font-weight:300;font-size:16px;margin-bottom:26px;line-height:1.9}
.tarjeta-valor{border-left:1px solid var(--dorado);padding-left:22px;margin-bottom:38px}
.tarjeta-valor h4{font-family:'Inter',sans-serif;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:var(--navy);margin-bottom:8px;font-weight:600}

/* CIERRE */
.seccion-cierre-premium{position:relative;overflow:hidden;background:#0D121E;text-align:center;padding:120px 12%;isolation:isolate}
.seccion-cierre-premium::before{content:"";position:absolute;inset:0;background-image:url('boceto.webp');background-size:cover;background-position:center 35%;opacity:0.35;z-index:1}
.seccion-cierre-premium::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 50%,rgba(200,176,144,.18) 0%,transparent 70%);z-index:1}
.contenido-cierre{position:relative;z-index:3;max-width:700px;margin:0 auto}
.subtitulo-cierre{color:var(--dorado);letter-spacing:3.5px;font-size:11px;text-transform:uppercase;display:block;margin-bottom:18px}
.seccion-cierre-premium h2{color:#fff;font-size:50px;margin-bottom:20px}
.seccion-cierre-premium p{color:rgba(255,255,255,.6);margin-bottom:35px;font-size:16px;font-weight:300}
.btn-premium-borde{border:1px solid rgba(255,255,255,.35);color:#fff;padding:16px 40px;letter-spacing:2.5px;font-size:11px;text-transform:uppercase;text-decoration:none;transition:.4s;display:inline-block}
.btn-premium-borde:hover{background:var(--dorado);border-color:var(--dorado);color:var(--navy)}

/* CONTACTO */
.contenedor-contacto{display:grid;grid-template-columns:1fr 1.3fr;gap:80px}
.formulario-contacto{display:grid;grid-template-columns:1fr 1fr;gap:50px 32px}
.campo-ancho{grid-column:span 2}.bloque-dato{margin-bottom:28px}.bloque-dato label{display:block;margin-bottom:10px;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--dorado)}
.campo-flotante{position:relative;display:block;width:100%}
.campo-flotante input,.campo-flotante textarea{display:block;width:100%;border:none;border-bottom:1.5px solid #C8B090;background:transparent;padding:18px 0 12px 0;font-family:'Inter',sans-serif;font-size:15px;color:#0D121E;outline:none}
.campo-flotante textarea{height:90px;resize:none;overflow:hidden}
.campo-flotante label{position:absolute;left:0;top:22px;color:#a0aec0;font-size:14px;pointer-events:none;transition:all .3s ease}
.campo-flotante input:focus + label,.campo-flotante input:not(:placeholder-shown) + label,.campo-flotante textarea:focus + label,.campo-flotante textarea:not(:placeholder-shown) + label{top:-12px;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#C8B090}
.boton-enviar{grid-column:span 2;width:100%;background:transparent;border:1.5px solid #C8B090;color:#0D121E;padding:22px 40px;margin-top:16px;letter-spacing:3px;text-transform:uppercase;font-size:12px;font-family:'Playfair Display',serif;cursor:pointer;transition:all .3s ease}
.boton-enviar:hover{background:#0D121E;color:#C8B090;transform:translateY(-2px)}

/* FOOTER NUEVO */
.footer-rgm{background:#070b14;padding:75px 5% 0;border-top:1px solid rgba(200,176,144,0.15);font-family:'Inter',sans-serif}
.footer-inner{max-width:1400px;margin:0 auto;display:grid;grid-template-columns:1.6fr 0.8fr 1fr 1fr;gap:50px;align-items:start}
.f-col.brand{display:flex;flex-direction:column;align-items:center}
.footer-isologo{height:62px;width:auto}
.f-claim{font-family:'Lora',serif;font-style:italic;font-size:14px;color:#9aa8c0;line-height:1.4;margin-top:20px;text-align:center}
.f-line{width:28px;height:1px;background:#C8B090;margin:22px 0}
.f-copy-brand{font-weight:300;font-size:10px;letter-spacing:2.8px;color:#8a92a6;line-height:1.9;text-transform:uppercase}
.f-title{display:block;font-size:10px;letter-spacing:3px;color:#C8B090;margin-bottom:22px;font-weight:600}
.f-col a{display:block;color:#a8aebb;text-decoration:none;font-size:13px;margin-bottom:11px}
.f-col a:hover{color:#E8DCC8}
.f-col p{font-size:13px;line-height:1.7;color:#8a90a0;margin:0}
.f-contact{margin-top:16px}
.f-btn{border:1px solid #C8B090;padding:12px 22px;display:inline-block!important;font-size:11px!important;letter-spacing:1.8px;color:#E8DCC8!important;margin-top:12px;text-decoration:none}
.f-bottom{max-width:1400px;margin:50px auto 0;padding:24px 0;border-top:1px solid rgba(255,255,255,0.06);text-align:center;font-size:10px;letter-spacing:1.2px;color:#4e5463}

/* PILL */
.investment-pill{display:inline-flex!important;align-items:center!important;gap:8px!important;height:34px!important;padding:0 16px 0 12px!important;border:1px solid rgba(200,176,144,0.45)!important;border-radius:24px!important;background:rgba(13,18,30,0.65)!important;backdrop-filter:blur(8px)!important;text-decoration:none!important;white-space:nowrap!important;opacity:0!important;transform:translateX(15px)!important;pointer-events:none!important;transition:all 0.5s ease!important}
.pill-new{font-family:'Inter',sans-serif!important;font-size:8.5px!important;font-weight:700!important;letter-spacing:1.2px!important;color:#0D121E!important;background:#C8B090!important;padding:4px 8px!important;border-radius:12px!important;line-height:1!important}
.pill-text{font-size:11px!important;letter-spacing:0.8px!important;color:#E8DCC8!important;font-weight:500!important}
body.pill-visible .investment-pill{opacity:1!important;transform:translateX(0)!important;pointer-events:auto!important}

/* BURGER + MOBILE */
.btn-burger{display:none;width:36px;height:36px;background:transparent;border:1px solid rgba(200,176,144,.4);flex-direction:column;justify-content:center;align-items:center;gap:5px;cursor:pointer}
.btn-burger span{display:block;width:18px;height:1.5px;background:#E8DCC8;transition:.3s}
.mobile-overlay{position:fixed;top:0;right:-100%;width:88%;max-width:340px;height:100vh;background:#0D121E;z-index:10000;transition:right .4s cubic-bezier(0.2,0.8,0.2,1);padding:24px;overflow-y:auto;border-left:1px solid rgba(200,176,144,.15)}
.mobile-overlay.open{right:0}
.mobile-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:32px;color:#C8B090;font-size:11px;letter-spacing:3px}
.mobile-head button{background:none;border:none;color:#fff;font-size:20px;cursor:pointer}
.mobile-links{list-style:none}
.mobile-links li{border-bottom:1px solid rgba(255,255,255,.07)}
.mobile-links a{display:block;padding:16px 0;color:#E8E8E8;text-decoration:none;font-size:12px;letter-spacing:2px;text-transform:uppercase}
.mobile-links .mobile-cta{border:none;margin-top:24px}
.mobile-links .mobile-cta a{border:1px solid #C8B090;text-align:center;padding:18px;color:#E8DCC8}
.acc-btn{width:100%;background:none;border:none;color:#E8E8E8;font-size:12px;letter-spacing:2px;text-transform:uppercase;padding:16px 0;display:flex;justify-content:space-between;align-items:center;cursor:pointer;font-family:'Inter',sans-serif}
.acc-panel{display:none;padding:0 0 16px 8px}
.acc-panel.open{display:block}
.acc-panel a{font-size:13px!important;letter-spacing:.5px!important;text-transform:none!important;color:#a8aebb!important;padding:10px 0!important}

@media(max-width:1150px){.mega-grid{grid-template-columns:repeat(2,1fr)}.mega-panel{grid-template-columns:140px 1fr;padding:28px 3%}}
@media(max-width:1024px){#estudio>div,.contenedor-contacto,.footer-inner{grid-template-columns:1fr}}
@media(max-width:768px){
  header{padding:12px 5%}header nav{display:none!important}.btn-burger{display:flex}
  .hero-contenedor-texto{margin:0 6%;padding-top:8vh;padding-bottom:100px;transform:none}
  .hero-contenedor-texto h1{font-size:32px;line-height:1.2}
  .btn-premium-final{width:fit-content;min-width:220px;padding:16px 32px;margin-top:35px;display:inline-flex;justify-content:center}
  section{padding:80px 6%}.barra-flotante-contacto{display:none}
  .investment-seal-link{right:5%;bottom:18%}.investment-seal{width:110px;height:110px}.seal-content{width:82px;height:82px}.seal-new{font-size:19px}
  .seal-ring{width:96px;height:96px}.seal-ring-2{width:104px;height:104px}.seal-ring-3{width:112px;height:112px}
  .hero-principal::after{height:120px;clip-path:polygon(0 75%,100% 100%,100% 100%,0 100%)}.hero-principal::before{bottom:118px}
}
